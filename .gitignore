*.exe
*.o
*.obj
*.out

# ── Python ─────────────────────────────────────────────
__pycache__/
*.py[cod]

# ── 日志 / 临时文件 ────────────────────────────────────
*.log
*.tmp
*.swp

# ── 系统杂项 ───────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
